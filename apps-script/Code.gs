// Zaki Ansyari Premium Portfolio — Google Apps Script Web App
// Isi SPREADSHEET_ID dan ADMIN_EMAILS sebelum deploy.
const SPREADSHEET_ID = "PASTE_YOUR_GOOGLE_SHEET_ID_HERE";
const ADMIN_EMAILS = ["your-admin-email@gmail.com"];
const OAUTH_CLIENT_ID = "PASTE_YOUR_GOOGLE_OAUTH_WEB_CLIENT_ID_HERE";
const SHEETS = {
 Profile:["key","name","image","intro","about","education","focus","location","email","whatsapp","cv","musicNote"],
 Skills:["id","title","description","level"], Projects:["id","title","category","description","url","year","image"],
 Timeline:["id","period","title","description"], Credentials:["id","kind","title","issuer","date","url"],
 Gallery:["id","title","image"], Songs:["id","title","artist","url"],
 Messages:["id","name","email","message","createdAt","status"],
 Guests:["id","name","message","createdAt","status"],

};
function doGet(e){try{const a=e&&e.parameter&&e.parameter.action||"site";if(a==="site")return out_({ok:true,data:readSite_()});return out_({ok:false,error:"Aksi tidak dikenal."});}catch(err){return out_({ok:false,error:String(err.message||err)});}}
function doPost(e){try{const b=JSON.parse(e&&e.postData&&e.postData.contents||"{}");switch(b.action){case"contact":return contact_(b);case"guestbook":return guestbook_(b);default:verifyAdmin_(b.idToken);switch(b.action){case"adminGet":return out_({ok:true,email:emailFromToken_(b.idToken),data:readSite_(),messages:readRows_("Messages"),guests:readRows_("Guests")});case"saveProfile":return saveProfile_(b.profile||{});case"saveItem":return saveItem_(b.type,b.item||{});case"uploadFile":return uploadFile_(b);case"deleteItem":return deleteItem_(b.type,b.id);case"deleteMessage":return deleteById_("Messages",b.id);case"moderateGuest":return moderateGuest_(b.id,b.status);case"stats":return out_({ok:true,stats:stats_()});default:throw Error("Aksi admin tidak dikenal.");}}}catch(err){return out_({ok:false,error:String(err.message||err)});}}
function setupSheets(){if(SPREADSHEET_ID.indexOf("PASTE_")===0)throw Error("Isi SPREADSHEET_ID di Code.gs dahulu.");const ss=SpreadsheetApp.openById(SPREADSHEET_ID);Object.keys(SHEETS).forEach(n=>{let sh=ss.getSheetByName(n);if(!sh)sh=ss.insertSheet(n);if(!sh.getLastRow())sh.appendRow(SHEETS[n]);sh.setFrozenRows(1);});seed_("Profile",["main","Zaki Ansyari","","Hari terbesar dalam hidup adalah ketika kita bertanggung jawab penuh atas sikap kita.","Saya adalah pelajar TJKT yang tertarik pada teknologi, jaringan komputer, dan pengembangan web.","SMK Negeri 1 Amuntai","TJKT · Web · Networking","Amuntai, Kalimantan Selatan","","","","Musik menjadi teman untuk fokus, refleksi, dan menikmati proses."]);seed_("Skills",[Utilities.getUuid(),"Computer & Hardware","Perawatan, instalasi sistem operasi, dan troubleshooting perangkat.","01"]);seed_("Skills",[Utilities.getUuid(),"Networking","Dasar jaringan, kabel UTP, dan konektivitas.","02"]);seed_("Skills",[Utilities.getUuid(),"Web Development","HTML, CSS, JavaScript, dan integrasi data.","03"]);seed_("Projects",[Utilities.getUuid(),"Personal Portfolio","WEB DEVELOPMENT","Website pribadi untuk profil dan karya.","","2026"]);seed_("Timeline",[Utilities.getUuid(),"2025 — SEKARANG","Belajar Teknik Jaringan Komputer","Mengembangkan dasar komputer, jaringan, dan keterampilan teknologi."]);return"Sheet database siap digunakan.";}
function seed_(name,row){const sh=SpreadsheetApp.openById(SPREADSHEET_ID).getSheetByName(name);if(sh.getLastRow()<2)sh.appendRow(row);}
function readSite_(){const p=readRows_("Profile")[0]||{};return{profile:p,skills:readRows_("Skills"),projects:readRows_("Projects"),timeline:readRows_("Timeline"),credentials:readRows_("Credentials"),gallery:readRows_("Gallery"),songs:readRows_("Songs"),guests:readRows_("Guests").filter(x=>x.status==="approved").slice(-30).reverse(),stats:stats_()};}
function readRows_(name){const sh=SpreadsheetApp.openById(SPREADSHEET_ID).getSheetByName(name);if(!sh||sh.getLastRow()<2)return[];const vals=sh.getDataRange().getDisplayValues(),heads=vals.shift();return vals.filter(r=>r.some(v=>v!=="")).map(r=>{const o={};heads.forEach((h,i)=>o[h]=r[i]);return o;});}
function contact_(b){const name=clean_(b.name,100),email=clean_(b.email,150),message=clean_(b.message,2000);if(!name||!message||!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email))throw Error("Nama, email valid, dan pesan wajib diisi.");append_("Messages",[Utilities.getUuid(),name,email,message,new Date(),"unread"]);return out_({ok:true});}
function guestbook_(b){const name=clean_(b.name,80),message=clean_(b.message,500);if(!name||!message)throw Error("Nama dan pesan wajib diisi.");append_("Guests",[Utilities.getUuid(),name,message,new Date(),"pending"]);return out_({ok:true});}
function saveProfile_(p){const fields=["name","image","intro","about","education","focus","location","email","whatsapp","cv","musicNote"];const clean={};fields.forEach(k=>clean[k]=clean_(p[k],k==="about"||k==="intro"||k==="musicNote"?1500:1000));if(!clean.name)throw Error("Nama wajib diisi.");["image","cv"].forEach(k=>{if(clean[k]&&!/^https:\/\/\S+$/i.test(clean[k]))throw Error(k+" harus URL HTTPS.");});if(clean.email&&!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(clean.email))throw Error("Email tidak valid.");const sh=SpreadsheetApp.openById(SPREADSHEET_ID).getSheetByName("Profile"),row=["main",...fields.map(k=>clean[k]||"")];if(sh.getLastRow()<2)sh.appendRow(row);else sh.getRange(2,1,1,row.length).setValues([row]);return out_({ok:true});}
function saveItem_(type,item){const map={skills:"Skills",projects:"Projects",timeline:"Timeline",credentials:"Credentials",gallery:"Gallery",songs:"Songs"};if(!map[type])throw Error("Jenis data tidak valid.");const sh=SpreadsheetApp.openById(SPREADSHEET_ID).getSheetByName(map[type]),headers=SHEETS[map[type]];ensureHeaders_(sh,headers);const id=clean_(item.id,100)||Utilities.getUuid(),clean={id};headers.slice(1).forEach(k=>clean[k]=clean_(item[k],k==="description"?1500:1000));if(!clean.title&&type!=="timeline")throw Error("Judul wajib diisi.");if(type==="timeline"&&!clean.title)throw Error("Judul perjalanan wajib diisi.");if(["gallery","credentials","projects","songs"].includes(type)&&clean.url&&!/^https:\/\/\S+$/i.test(clean.url))throw Error("Tautan harus HTTPS.");if(type==="projects"&&clean.image&&!/^https:\/\/\S+$/i.test(clean.image))throw Error("URL gambar proyek harus HTTPS.");if(type==="gallery"&&(!clean.image||!/^https:\/\/\S+$/i.test(clean.image)))throw Error("URL gambar HTTPS wajib diisi.");if(type==="songs"&&!clean.url)throw Error("URL lagu wajib diisi.");const rows=sh.getDataRange().getDisplayValues();let rn=0;for(let i=1;i<rows.length;i++)if(rows[i][0]===id){rn=i+1;break;}const row=headers.map(h=>h==="id"?id:clean[h]||"");if(rn)sh.getRange(rn,1,1,row.length).setValues([row]);else sh.appendRow(row);return out_({ok:true});}
function ensureHeaders_(sh,headers){const current=sh.getRange(1,1,1,Math.max(1,sh.getLastColumn())).getDisplayValues()[0];headers.forEach(h=>{if(!current.includes(h)){sh.getRange(1,current.length+1).setValue(h);current.push(h);}});}function deleteItem_(type,id){const map={skills:"Skills",projects:"Projects",timeline:"Timeline",credentials:"Credentials",gallery:"Gallery",songs:"Songs"};if(!map[type])throw Error("Jenis data tidak valid.");return deleteById_(map[type],id);}
function deleteById_(sheetName,id){const sh=SpreadsheetApp.openById(SPREADSHEET_ID).getSheetByName(sheetName),rows=sh.getDataRange().getDisplayValues();for(let i=1;i<rows.length;i++)if(rows[i][0]===String(id)){sh.deleteRow(i+1);return out_({ok:true});}throw Error("Data tidak ditemukan.");}
function moderateGuest_(id,status){if(!["approved","pending","hidden"].includes(status))throw Error("Status tidak valid.");const sh=SpreadsheetApp.openById(SPREADSHEET_ID).getSheetByName("Guests"),rows=sh.getDataRange().getDisplayValues();for(let i=1;i<rows.length;i++)if(rows[i][0]===String(id)){sh.getRange(i+1,5).setValue(status);return out_({ok:true});}throw Error("Pesan buku tamu tidak ditemukan.");}
function append_(sheet,row){SpreadsheetApp.openById(SPREADSHEET_ID).getSheetByName(sheet).appendRow(row);}
function stats_(){const p=PropertiesService.getScriptProperties(),today=Utilities.formatDate(new Date(),Session.getScriptTimeZone(),"yyyy-MM-dd"),key="VISITS_"+today;return{visits:Number(p.getProperty("VISITS_TOTAL")||0),today:Number(p.getProperty(key)||0)};}
function countVisit_(){const p=PropertiesService.getScriptProperties(),today=Utilities.formatDate(new Date(),Session.getScriptTimeZone(),"yyyy-MM-dd"),key="VISITS_"+today;p.setProperty("VISITS_TOTAL",String(Number(p.getProperty("VISITS_TOTAL")||0)+1));p.setProperty(key,String(Number(p.getProperty(key)||0)+1));}
function verifyAdmin_(token){if(!token)throw Error("Login admin diperlukan.");const r=UrlFetchApp.fetch("https://oauth2.googleapis.com/tokeninfo?id_token="+encodeURIComponent(token),{muteHttpExceptions:true});if(r.getResponseCode()!==200)throw Error("Token Google tidak valid atau kedaluwarsa.");const i=JSON.parse(r.getContentText());if(i.aud!==OAUTH_CLIENT_ID)throw Error("OAuth Client ID tidak cocok.");if(i.email_verified!=="true")throw Error("Email belum terverifikasi.");const email=String(i.email||"").toLowerCase();if(!ADMIN_EMAILS.map(x=>String(x).toLowerCase().trim()).includes(email))throw Error("Email ini tidak memiliki akses admin.");return true;}
function emailFromToken_(token){const r=UrlFetchApp.fetch("https://oauth2.googleapis.com/tokeninfo?id_token="+encodeURIComponent(token));return JSON.parse(r.getContentText()).email||"Admin";}
function clean_(v,n){let s=String(v==null?"":v).trim().slice(0,n||1000);if(/^[=+\-@]/.test(s))s="'"+s;return s;}
function out_(o){return ContentService.createTextOutput(JSON.stringify(o)).setMimeType(ContentService.MimeType.JSON);}
function authorizeDriveAccess(){DriveApp.getRootFolder().getId();}
function uploadFile_(b){
const mime=String(b.mimeType||"").toLowerCase(),allowed=["image/jpeg","image/png","image/gif","image/webp","application/pdf","application/msword","application/vnd.openxmlformats-officedocument.wordprocessingml.document"];
if(allowed.indexOf(mime)===-1)throw Error("Jenis file tidak didukung. Gunakan gambar JPG, PNG, GIF, WebP, PDF, DOC, atau DOCX.");
const encoded=String(b.data||"");
if(!encoded||encoded.length>11184812)throw Error("File wajib dipilih dan ukurannya maksimal 8 MB.");
const bytes=Utilities.base64Decode(encoded);
if(bytes.length>8*1024*1024)throw Error("Ukuran file maksimal 8 MB.");
const name=String(b.fileName||"upload").replace(/[\\/:*?"<>|]/g,"_").slice(0,120)||"upload";
const properties=PropertiesService.getScriptProperties(),folderKey="PORTFOLIO_UPLOAD_FOLDER_ID";
let folderId=properties.getProperty(folderKey),folder;
if(folderId)folder=DriveApp.getFolderById(folderId);
else{folder=DriveApp.createFolder("Portfolio Website Uploads");properties.setProperty(folderKey,folder.getId());}
const file=folder.createFile(Utilities.newBlob(bytes,mime,name));
try{file.setSharing(DriveApp.Access.ANYONE_WITH_LINK,DriveApp.Permission.VIEW);}
catch(err){try{file.setTrashed(true);}catch(cleanupError){throw Error("File dibuat, tetapi izin berbagi gagal dan file sementara tidak dapat dibersihkan: "+cleanupError.message);}throw Error("Google Drive menolak akses publik untuk file ini. Periksa kebijakan berbagi akun Drive: "+err.message);}
const id=file.getId(),url=mime.indexOf("image/")===0?"https://drive.google.com/uc?export=view&id="+id:"https://drive.google.com/file/d/"+id+"/view?usp=sharing";
return out_({ok:true,url:url,fileName:name});
}
